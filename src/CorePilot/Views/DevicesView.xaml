<UserControl x:Class="CorePilot.Views.DevicesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:CorePilot.ViewModels"
             xmlns:conv="clr-namespace:CorePilot.Converters">
  <UserControl.Resources>
    <conv:LoadToBrushConverter x:Key="LoadBrush"/>
    <conv:BoolToVisibilityConverter x:Key="BoolVis"/>
    <conv:InverseBoolConverter x:Key="InvBool"/>
  </UserControl.Resources>

  <Grid Margin="24,16">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="370"/>
      <ColumnDefinition Width="*"/>
    </Grid.ColumnDefinitions>

    <!-- Device list -->
    <Border Grid.Column="0" Style="{StaticResource PanelBorder}" Margin="0,0,12,0">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Style="{StaticResource SectionHeader}" Text="INTERRUPT DEVICES"/>
        <TextBox Grid.Row="1" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                 Margin="0,0,0,10">
          <TextBox.ToolTip>Filter by name, class or instance id</TextBox.ToolTip>
        </TextBox>

        <ListBox Grid.Row="2" ItemsSource="{Binding FilteredDevices}"
                 SelectedItem="{Binding SelectedDevice}">
          <ListBox.ItemTemplate>
            <DataTemplate DataType="{x:Type vm:DeviceViewModel}">
              <Grid Width="290">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                  <TextBlock Text="{Binding DisplayName}" FontSize="13" FontWeight="SemiBold"
                             Foreground="{StaticResource TextBrush}" TextTrimming="CharacterEllipsis"/>
                  <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                    <TextBlock Text="{Binding ClassName}" FontSize="11" Foreground="{StaticResource TextDim}"/>
                    <TextBlock Text="  MSI" FontSize="11" FontWeight="Bold" Foreground="{StaticResource Cyan}"
                               Visibility="{Binding MsiSupported, Converter={StaticResource BoolVis}}"/>
                    <TextBlock Text="  ⚠ BOOT-CRITICAL" FontSize="11" FontWeight="Bold" Foreground="{StaticResource Amber}"
                               Visibility="{Binding IsBootCritical, Converter={StaticResource BoolVis}}"/>
                  </StackPanel>
                </StackPanel>
                <Border Grid.Column="1" VerticalAlignment="Center" Padding="7,2" CornerRadius="3"
                        Background="{StaticResource PanelAlt}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                  <TextBlock Text="{Binding StateSummary}" FontSize="10">
                    <TextBlock.Style>
                      <Style TargetType="TextBlock">
                        <Setter Property="Foreground" Value="{StaticResource TextDim}"/>
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding IsPending}" Value="True">
                            <Setter Property="Foreground" Value="{StaticResource Amber}"/>
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </TextBlock.Style>
                  </TextBlock>
                </Border>
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>

        <Grid Grid.Row="3" Margin="0,10,0,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>
          <Button Content="REFRESH" Command="{Binding RefreshCommand}"/>
          <Button Grid.Column="1" Content="RESTORE ALL" Command="{Binding RestoreAllCommand}" Margin="8,0,0,0"/>
        </Grid>
      </Grid>
    </Border>

    <!-- Detail pane -->
    <Border Grid.Column="1" Style="{StaticResource PanelBorder}">
      <Grid>
        <!-- Empty state -->
        <TextBlock Text="Select a device to tune its interrupt affinity"
                   Foreground="{StaticResource TextDim}" FontSize="14"
                   HorizontalAlignment="Center" VerticalAlignment="Center"
                   Visibility="{Binding HasSelectedDevice, Converter={StaticResource InvBool}}"/>

        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      Visibility="{Binding HasSelectedDevice, Converter={StaticResource BoolVis}}">
          <StackPanel>
            <TextBlock Text="{Binding SelectedDevice.DisplayName}" FontSize="20" FontWeight="Bold"/>
            <TextBlock Text="{Binding SelectedDevice.InstanceId}" FontSize="11"
                       Foreground="{StaticResource TextDim}" FontFamily="{StaticResource MonoFont}"
                       Margin="0,2,0,14" TextWrapping="Wrap"/>

            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="220"/>
              </Grid.ColumnDefinitions>
              <StackPanel>
                <TextBlock Style="{StaticResource SectionHeader}" Text="AFFINITY POLICY"/>
                <ComboBox ItemsSource="{Binding PolicyOptions}" SelectedItem="{Binding SelectedPolicy}"
                          MaxWidth="380" HorizontalAlignment="Left">
                  <ComboBox.ItemTemplate>
                    <DataTemplate>
                      <TextBlock Text="{Binding}"/>
                    </DataTemplate>
                  </ComboBox.ItemTemplate>
                </ComboBox>
              </StackPanel>
              <StackPanel Grid.Column="1">
                <TextBlock Style="{StaticResource SectionHeader}" Text="INTERRUPT PRIORITY"/>
                <ComboBox ItemsSource="{Binding PriorityOptions}" SelectedItem="{Binding SelectedPriority}"
                          HorizontalAlignment="Stretch"/>
              </StackPanel>
            </Grid>

            <Grid Margin="0,16,0,6">
              <TextBlock Style="{StaticResource SectionHeader}" Text="CPU CORES  —  tile color = live interrupt load"/>
              <TextBlock HorizontalAlignment="Right" Foreground="{StaticResource TextDim}" FontSize="11"
                         Text="● recommended by Core Radar" VerticalAlignment="Center" Margin="0,0,0,4"/>
            </Grid>

            <Border Background="{StaticResource PanelAlt}" BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1" CornerRadius="4" Padding="10">
              <ItemsControl ItemsSource="{Binding Cores}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <UniformGrid Columns="8"/>
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate DataType="{x:Type vm:CoreViewModel}">
                    <ToggleButton IsChecked="{Binding IsSelected}" Margin="3" MinHeight="48" Cursor="Hand">
                      <ToggleButton.Template>
                        <ControlTemplate TargetType="ToggleButton">
                          <Border x:Name="bd" CornerRadius="4" BorderThickness="1.5"
                                  BorderBrush="{StaticResource BorderBrush}"
                                  Background="{Binding LoadScore, Converter={StaticResource LoadBrush}}">
                            <StackPanel VerticalAlignment="Center">
                              <TextBlock Text="{Binding Label}" HorizontalAlignment="Center"
                                         FontSize="14" FontWeight="Bold" Foreground="#FFEAF6EE"/>
                              <TextBlock HorizontalAlignment="Center" FontSize="9.5" Foreground="#BFEAF6EE">
                                <TextBlock.Text>
                                  <MultiBinding StringFormat="{}{0:0.#}% IRQ">
                                    <Binding Path="InterruptTimePercent"/>
                                  </MultiBinding>
                                </TextBlock.Text>
                              </TextBlock>
                            </StackPanel>
                          </Border>
                          <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                              <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource Accent}"/>
                              <Setter TargetName="bd" Property="Effect">
                                <Setter.Value>
                                  <DropShadowEffect Color="{StaticResource AccentColor}" BlurRadius="12"
                                                    ShadowDepth="0" Opacity="0.8"/>
                                </Setter.Value>
                              </Setter>
                            </Trigger>
                            <DataTrigger Binding="{Binding IsRecommended}" Value="True">
                              <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource Cyan}"/>
                            </DataTrigger>
                            <Trigger Property="IsMouseOver" Value="True">
                              <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource TextBrush}"/>
                            </Trigger>
                          </ControlTemplate.Triggers>
                        </ControlTemplate>
                      </ToggleButton.Template>
                      <ToggleButton.ToolTip>
                        <StackPanel>
                          <TextBlock FontWeight="Bold"><Run Text="Core "/><Run Text="{Binding Label, Mode=OneWay}"/></TextBlock>
                          <TextBlock><Run Text="Interrupt: "/><Run Text="{Binding InterruptTimePercent, Mode=OneWay, StringFormat=0.00}"/><Run Text="%"/></TextBlock>
                          <TextBlock><Run Text="DPC: "/><Run Text="{Binding DpcTimePercent, Mode=OneWay, StringFormat=0.00}"/><Run Text="%"/></TextBlock>
                          <TextBlock><Run Text="Interrupts/s: "/><Run Text="{Binding InterruptsPerSec, Mode=OneWay, StringFormat=0}"/></TextBlock>
                        </StackPanel>
                      </ToggleButton.ToolTip>
                    </ToggleButton>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </Border>

            <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
              <Button Content="APPLY" Style="{StaticResource AccentButton}"
                      Command="{Binding ApplyCommand}" MinWidth="140"/>
              <Button Content="RESTART DEVICE" Command="{Binding RestartSelectedCommand}"
                      Margin="10,0,0,0" MinWidth="150"/>
              <Button Content="RESTORE DEFAULTS" Command="{Binding RestoreDefaultsCommand}"
                      Margin="10,0,0,0" MinWidth="150"/>
            </StackPanel>

            <TextBlock Text="{Binding DetailStatus}" Foreground="{StaticResource Amber}"
                       FontSize="12" Margin="0,12,0,0" TextWrapping="Wrap"/>
          </StackPanel>
        </ScrollViewer>
      </Grid>
    </Border>
  </Grid>
</UserControl>
